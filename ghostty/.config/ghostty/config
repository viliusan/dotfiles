font-family = Jetbrains Mono Nerd Font
font-size = 12
theme = Gruvbox Dark
background-opacity=0.9
background-blur-radius=20
gtk-titlebar = false
macos-icon = retro
keybind = shift+enter=text:\n

keybind = cmd+arrow_left=goto_split:left
keybind = cmd+arrow_right=goto_split:right
keybind = cmd+arrow_down=goto_split:bottom
keybind = cmd+arrow_up=goto_split:top
